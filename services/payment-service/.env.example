# Payment service env. Prefer DATABASE_URL; otherwise the shared Prisma
# client synthesizes it from PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE.
PORT=3003
DATABASE_URL="postgresql://postgres:00000000@localhost:5432/payment"

KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="payment-service"
KAFKA_GROUP_ID="payment-service-group"

JWT_INTERNAL_SECRET="dev-internal-secret-change-me"

OUTBOX_POLL_INTERVAL_MS=2000

# Provider selection: mock (default, no keys) or stripe (real API).
PAYMENT_PROVIDER=mock

# Fallback charge amount when the event carries no total (minor units + code).
PAYMENT_DEFAULT_AMOUNT_MINOR=1999
PAYMENT_DEFAULT_CURRENCY=USD

# Mock failure injection (chaos testing):
# PAYMENT_DECLINE_CODE=card_declined
# PAYMENT_LATENCY_MS=5000

# Real Stripe (PAYMENT_PROVIDER=stripe):
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_TEST_PAYMENT_METHOD="pm_card_visa"

# Circuit breaker tuning:
# CB_FAILURE_THRESHOLD=3
# CB_TIMEOUT_MS=2000
# CB_RESET_MS=10000

# Inventory service env. Prefer DATABASE_URL; otherwise the shared Prisma
# client synthesizes it from PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE.
PORT=3001
DATABASE_URL="postgresql://postgres:00000000@localhost:5432/inventory"

KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="inventory-service"
KAFKA_GROUP_ID="inventory-service-group"

JWT_INTERNAL_SECRET="dev-internal-secret-change-me"

OUTBOX_POLL_INTERVAL_MS=2000

# Chaos kill-switch: INVENTORY_FAIL_RESERVE=1 forces reserve-path failures.
# INVENTORY_FAIL_RESERVE=0

# Seed override: SEED_SKUS="SKU-A:100,SKU-B:50"

# Order service env. Prefer DATABASE_URL; otherwise the shared Prisma
# client synthesizes it from PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE.
PORT=3000
DATABASE_URL="postgresql://postgres:00000000@localhost:5432/app"

KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="order-service"
KAFKA_GROUP_ID="order-service-group"

JWT_INTERNAL_SECRET="dev-internal-secret-change-me"

OUTBOX_POLL_INTERVAL_MS=2000

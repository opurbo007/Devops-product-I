# Notification service env. Prefer DATABASE_URL; otherwise the shared Prisma
# client synthesizes it from PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE.
PORT=3004
DATABASE_URL="postgresql://postgres:00000000@localhost:5432/notification"

KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="notification-service"
KAFKA_GROUP_ID="notification-service-group"

JWT_INTERNAL_SECRET="dev-internal-secret-change-me"

OUTBOX_POLL_INTERVAL_MS=2000

# Mock-send failure injection (chaos testing, circuit-breaker demo):
# NOTIFICATION_FAIL=1
# CB_FAILURE_THRESHOLD=3
# CB_TIMEOUT_MS=1000
# CB_RESET_MS=10000

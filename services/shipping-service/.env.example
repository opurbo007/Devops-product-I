# Shipping service env. Prefer DATABASE_URL; otherwise the shared Prisma
# client synthesizes it from PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE.
PORT=3002
DATABASE_URL="postgresql://postgres:00000000@localhost:5432/shipping"

KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="shipping-service"
KAFKA_GROUP_ID="shipping-service-group"

JWT_INTERNAL_SECRET="dev-internal-secret-change-me"

OUTBOX_POLL_INTERVAL_MS=2000

# Chaos kill-switch: SHIPPING_FAIL_DISPATCH=1 forces dispatch-path failures.
# SHIPPING_FAIL_DISPATCH=0

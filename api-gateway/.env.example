# API gateway env.
PORT=8080

ORDER_SERVICE_URL="http://localhost:3000"
INVENTORY_SERVICE_URL="http://localhost:3001"
SHIPPING_SERVICE_URL="http://localhost:3002"
PAYMENT_SERVICE_URL="http://localhost:3003"
NOTIFICATION_SERVICE_URL="http://localhost:3004"
CART_SERVICE_URL="http://localhost:3005"

# Postgres (auth users live in the gateway DB).
DATABASE_URL="postgresql://postgres:00000000@localhost:5432/app"

JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_INTERNAL_SECRET="dev-internal-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Redis-backed rate limiting (falls back to memory when unset/unreachable).
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_WINDOW_MS=900000

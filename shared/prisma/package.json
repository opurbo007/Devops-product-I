{
  "name": "shared-prisma",
  "version": "1.0.0",
  "description": "Shared Prisma ORM package — single source of truth for all Postgres models (users, orders, stock, payments, shipments, carts, notifications + outbox/processed_events).",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
